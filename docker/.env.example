# Optional: docker compose --env-file docker/.env up -d --build
# Copy this example to docker/.env; default local settings need no env file.
DOCKER_MYSQL_ROOT_PASSWORD=ecom-local-root-password
DOCKER_MYSQL_PASSWORD=ecom-local-password
DOCKER_JWT_SECRET=docker-local-jwt-secret-change-before-sharing-1234567890
DOCKER_ORDER_SYNC_KEY=docker-local-order-sync-key-1234567890123456
DOCKER_PAYMENT_SYNC_KEY=docker-local-payment-sync-key-12345678901234
DOCKER_FULFILLMENT_SYNC_KEY=docker-local-fulfillment-sync-key-1234567890
DOCKER_INVENTORY_SYNC_KEY=docker-local-inventory-sync-key-123456789012
# Host ports; internal service addresses stay unchanged.
DOCKER_API_GATEWAY_PORT=18080
DOCKER_EUREKA_PORT=18081
DOCKER_CONFIG_SERVER_PORT=18082
DOCKER_ORG_ACCESS_PORT=18083
DOCKER_CUSTOMER_PROFILE_SERVICE_PORT=18084
DOCKER_CATALOG_SERVICE_PORT=18085
DOCKER_INVENTORY_SERVICE_PORT=18086
DOCKER_CART_SERVICE_PORT=18087
DOCKER_ORDER_SERVICE_PORT=18088
DOCKER_PAYMENT_SERVICE_PORT=18089
DOCKER_FULFILLMENT_SERVICE_PORT=18090
DOCKER_NOTIFICATION_SERVICE_PORT=18091
DOCKER_ALERTS_SERVICE_PORT=18092
DOCKER_MAIL_UI_PORT=18093

# Java application heap sizes; total process memory also includes native memory.
DOCKER_JAVA_XMS=32m
DOCKER_JAVA_XMX=192m
# Hikari database pool settings per application.
DOCKER_DB_POOL_MAX=5
DOCKER_DB_POOL_MIN_IDLE=1
