# Optional: docker compose --env-file docker/.env up -d --build
# Copy this example to docker/.env; default local settings need no env file.
DOCKER_MYSQL_ROOT_PASSWORD=ecom-local-root-password
DOCKER_MYSQL_PASSWORD=ecom-local-password
DOCKER_JWT_SECRET=docker-local-jwt-secret-change-before-sharing-1234567890
DOCKER_ORDER_SYNC_KEY=docker-local-order-sync-key-1234567890123456
DOCKER_PAYMENT_SYNC_KEY=docker-local-payment-sync-key-12345678901234
DOCKER_FULFILLMENT_SYNC_KEY=docker-local-fulfillment-sync-key-1234567890
DOCKER_INVENTORY_SYNC_KEY=docker-local-inventory-sync-key-123456789012
# Host ports can be changed without changing internal service addresses.
DOCKER_EUREKA_PORT=8761
DOCKER_CONFIG_SERVER_PORT=8888
DOCKER_API_GATEWAY_PORT=8082
DOCKER_MAIL_UI_PORT=8025
